# Local-only settings for `pmo-agent` and tests. Never commit .env.
PMO_ENVIRONMENT=local
PMO_FOUNDRY_PROJECT_ENDPOINT=https://your-resource.services.ai.azure.com/api/projects/your-project
# Name of the Claude model deployment in that Foundry resource.
PMO_ANTHROPIC_MODEL=your-claude-deployment
PMO_ADO_ORGANIZATION=your-organization
# Optional extra guard; the real boundary is the agent user's Azure DevOps access.
# PMO_ADO_PROJECT=your-project
# Azurite test values (public, local-only; not Azure credentials).
PMO_STORAGE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=pmolocal;AccountKey=cG1vLWxvY2FsLWRldmVsb3BtZW50LW9ubHktdGVzdC1rZXk=;BlobEndpoint=http://127.0.0.1:10000/pmolocal;
# Optional overrides (JSON). Only agent365.svc / workiq.svc hosts are accepted.
# PMO_M365_SERVERS={"teams":"https://agent365.svc.cloud.microsoft/agents/servers/mcp_TeamsServer"}
# PMO_ALLOWED_TOOLS=["ado__wit_work_item","teams__mcp_graph_chat_listChatMessages"]
OTEL_INSTRUMENTATION_GENAI_CAPTURE_MESSAGE_CONTENT=false
